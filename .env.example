# =============================================================================
# Excalidraw — environment variables
#
# Local dev:   copy this file to .env at the repo root and fill in values.
# Production:  set these in Vercel (frontend) and Railway (backend + ws)
#              via each platform's dashboard. Do NOT commit .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon, Supabase, or any Postgres)
#   Used by the http-backend and web-socket-backend.
#   Must be a connection string with ?sslmode=require for managed Postgres.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# JWT signing secret (http-backend + web-socket-backend must share this value)
#   Generate with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string"

# -----------------------------------------------------------------------------
# HTTP backend  (apps/http-backend)
# -----------------------------------------------------------------------------
HTTP_PORT=3001
# Comma-separated list of allowed origins for CORS.
# In prod: set to your Vercel URL, e.g. https://draw.ansht.tech
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# -----------------------------------------------------------------------------
# WebSocket backend  (apps/web-socket-backend)
# -----------------------------------------------------------------------------
WS_PORT=8081

# -----------------------------------------------------------------------------
# Frontend  (apps/web) — only NEXT_PUBLIC_* vars are bundled into the client.
#   Set these in Vercel → Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8081

# In production:
# NEXT_PUBLIC_BACKEND_URL=https://excalidraw-backend.up.railway.app
# NEXT_PUBLIC_WEBSOCKET_URL=wss://excalidraw-ws.up.railway.app
